# =============================================================================
# Project Desk - Backend Environment Variables
# Copy this file to `.env` in the `backend/` directory and fill in your values.
# =============================================================================

# Django
DJANGO_SECRET_KEY=change-this-in-production
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_LOG_LEVEL=INFO

# Database (PostgreSQL in config; change to sqlite3 via settings if preferred)
DB_NAME=project_desk_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Frontend URL (used by payment redirect + email links)
FRONTEND_URL=http://localhost:5173

# =============================================================================
# EMAIL SETTINGS (Phase 2 - email verification + forgot password)
# =============================================================================
#
# DEVELOPMENT:
#   `config/settings/dev.py` sets EMAIL_BACKEND to the console backend.
#   Emails print to the Django runserver terminal - you can read the
#   6-digit codes there while testing. No SMTP credentials needed in dev.
#
# PRODUCTION (Gmail SMTP):
#   1. Enable 2-Step Verification on your Google account:
#      https://myaccount.google.com/security
#   2. Create a Gmail App Password (16 characters):
#      https://myaccount.google.com/apppasswords
#      Use the app password below, NOT your normal Gmail password.
#   3. Uncomment and fill in the settings below.
#
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=your16charapppassword
# DEFAULT_FROM_EMAIL=Project Desk <you@gmail.com>

# =============================================================================
# KHALTI (payment gateway)
# =============================================================================
KHALTI_SECRET_KEY=2a783fb50bdb4c1c8ae10cbc159b9b94
KHALTI_ENV=dev
